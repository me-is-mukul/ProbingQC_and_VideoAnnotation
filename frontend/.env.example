# Copy to .env.local and adjust. Every value has a sensible default for local development.

# Repo root that contains src/probing_qc (the Python pipeline). Default: the folder above frontend/.
PIPELINE_ROOT=..

# Python interpreter with probing_qc installed. Default: <PIPELINE_ROOT>/venv/Scripts/python.exe
# on Windows, <PIPELINE_ROOT>/venv/bin/python elsewhere.
# PYTHON_BIN=

# Where uploads and job folders are written. Default: ./.data (git-ignored).
# On GCP point this at a persistent disk or a mounted bucket.
DATA_DIR=./.data

# Largest accepted upload in bytes. Default: 21474836480 (20 GiB, a long 4K GoPro file).
MAX_UPLOAD_BYTES=21474836480

# Jobs processed at the same time; the rest wait in a queue. Video QC uses all CPU cores,
# so 1 per vCPU-heavy instance keeps runtimes predictable. Default: 1.
MAX_CONCURRENT_JOBS=1

# Allow URLs that point at localhost / private networks (SSRF protection). Default: false.
ALLOW_PRIVATE_URLS=false
